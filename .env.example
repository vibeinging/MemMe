# MemMe Environment Variables
# Copy this file to .env and fill in your values.

# ── Embedding Provider ─────────────────────────────────────────
# OpenAI-compatible embedding API key (also used by DashScope etc.)
# OPENAI_API_KEY=sk-your-key-here

# Custom embedding API base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding model name (default: text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (auto-detected if not set)
# EMBEDDING_DIMS=1536

# ── LLM Provider ──────────────────────────────────────────────
# LLM API key (used by memme-core auto-restore)
# MEMME_LLM_API_KEY=sk-your-key-here
# MEMME_API_KEY=sk-your-key-here

# LLM API base URL (default: https://api.openai.com)
# LLM_BASE_URL=https://api.openai.com

# LLM model name (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# DashScope API key (Alibaba Cloud, used in benchmarks/tests)
# DASHSCOPE_API_KEY=sk-your-key-here

# ── Ollama (Local LLM/Embedding) ──────────────────────────────
# Ollama server host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# ── Rerank Provider ───────────────────────────────────────────
# Rerank API key (Jina / Cohere / DashScope)
# RERANK_API_KEY=your-key-here

# Rerank API base URL
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# Rerank model name
# RERANK_MODEL=gte-rerank

# ── Build Configuration (MemMe-DB) ─────────���─────────────────
# Required only when building with --features memme-db
# DUCKDB_LIB_DIR=db_engine/build/release
# DUCKDB_INCLUDE_DIR=db_engine/duckdb/src/include
# DUCKDB_STATIC=1
